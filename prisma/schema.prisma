generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PRINCIPAL
  ADMIN
  TEACHER
  ACCOUNTANT
  REGISTRAR
  COUNSELOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum StudentStatus {
  PENDING_ENROLLMENT
  ACTIVE
  INACTIVE
  SUSPENDED
  EXPELLED
  TRANSFERRED
  WITHDRAWN
  GRADUATED
}

enum RegistrationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ENROLLED
}

enum RegistrationDocumentType {
  PHOTO
  PREVIOUS_ACADEMIC_RECORD
  TRANSCRIPT
  REPORT_CARD
  BIRTH_CERTIFICATE
  TRANSFER_CERTIFICATE
  MEDICAL_RECORD
  PARENT_ID
  OTHER
}

enum TermType {
  QUARTER
  SEMESTER
  YEAR
  FINAL
}

enum AssessmentType {
  ASSIGNMENT
  QUIZ
  TEST
  EXAM
  PROJECT
  OTHER
}

enum GradeStatus {
  DRAFT
  SUBMITTED
  LOCKED
  PUBLISHED
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHECK
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DisciplineActionType {
  WARNING
  DETENTION
  COUNSELING
  SUSPENSION
  EXPULSION
  OTHER
}

enum CounselingCategory {
  ACADEMIC
  BEHAVIOR
  ATTENDANCE
  MENTAL_HEALTH
  FAMILY
  CAREER
  OTHER
}

enum RiskLevel {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterventionStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum Stream {
  NATURAL_SCIENCE
  SOCIAL_SCIENCE
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  passwordHash       String
  role               Role
  status             UserStatus @default(ACTIVE)
  firstName          String
  lastName           String
  phone              String?
  mustChangePassword Boolean    @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  teacher             TeacherProfile?
  staff               StaffProfile?
  student             StudentProfile?
  registrationsCreated  RegistrationApplication[] @relation("RegistrationCreator")
  registrationsReviewed RegistrationApplication[] @relation("RegistrationReviewer")
  uploadedRegistrationDocuments RegistrationDocument[] @relation("RegistrationDocumentUploader")
  verifiedRegistrationDocuments RegistrationDocument[] @relation("RegistrationDocumentVerifier")
  promotionLogs       PromotionLog[] @relation("PromotionActor")
  auditLogs           AuditLog[] @relation("Actor")

  @@index([role, status])
}

model StaffProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId    String   @unique
  title      String?
  department String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TeacherProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId    String   @unique
  title      String?
  department String?
  isActive   Boolean  @default(true)
  subjects   TeacherSubject[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model RegistrationPeriod {
  id             String   @id @default(cuid())
  academicYear   String
  name           String
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean  @default(false)
  allowPrincipal Boolean  @default(true)
  allowRegistrar Boolean  @default(true)
  allowCounselor Boolean  @default(true)
  allowAdmin     Boolean  @default(true)
  applications   RegistrationApplication[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([academicYear, name])
}

model RegistrationApplication {
  id                   String               @id @default(cuid())
  registrationPeriodId String?
  registrationPeriod   RegistrationPeriod?  @relation(fields: [registrationPeriodId], references: [id])
  status               RegistrationStatus   @default(DRAFT)
  firstName            String
  middleName           String?
  lastName             String
  dateOfBirth          DateTime
  gender               String
  nationality          String?
  ethnicity            String?
  religion             String?
  applyingGradeLevel   Int
  photoUrl             String?
  previousSchoolName   String?
  previousSchoolGrade  String?
  previousAcademicYear String?
  transferReason       String?
  guardianName         String?
  guardianRelationship String?
  guardianPhone        String?
  guardianEmail        String?
  guardianAddress      String?
  emergencyContactName String?
  emergencyContactPhone String?
  medicalNotes         String?
  createdById          String?
  createdBy            User?                @relation("RegistrationCreator", fields: [createdById], references: [id])
  reviewedById         String?
  reviewedBy           User?                @relation("RegistrationReviewer", fields: [reviewedById], references: [id])
  reviewedAt           DateTime?
  rejectionReason      String?
  studentId            String?              @unique
  student              StudentProfile?      @relation(fields: [studentId], references: [id])
  documents            RegistrationDocument[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  @@index([status, applyingGradeLevel])
  @@index([lastName, firstName])
}

model RegistrationDocument {
  id             String                   @id @default(cuid())
  registrationId String
  registration   RegistrationApplication  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  type           RegistrationDocumentType
  title          String
  url            String
  mimeType       String
  fileSize       Int
  uploadedById   String?
  uploadedBy     User?                    @relation("RegistrationDocumentUploader", fields: [uploadedById], references: [id])
  verifiedById   String?
  verifiedBy     User?                    @relation("RegistrationDocumentVerifier", fields: [verifiedById], references: [id])
  verifiedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  @@index([registrationId, type])
}

model StudentProfile {
  id                    String          @id @default(cuid())
  userId                String?         @unique
  user                  User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  admissionNumber       String          @unique
  firstName             String
  middleName            String?
  lastName              String
  dateOfBirth           DateTime
  gender                String
  ethnicity             String?
  nationality           String?
  religion              String?
  gradeLevel            Int
  homeroom              String?
  status                StudentStatus   @default(PENDING_ENROLLMENT)
  enrollmentDate        DateTime
  expectedGraduation    DateTime?
  addressLine1          String?
  city                  String?
  state                 String?
  postalCode            String?
  country               String?
  guardianName          String?
  guardianRelationship  String?
  guardianPhone         String?
  guardianEmail         String?
  emergencyContactName  String?
  emergencyContactPhone String?
  medicalNotes          String?
  photoUrl              String?
  previousSchoolName    String?
  previousSchoolGrade   String?
  previousAcademicYear  String?
  transferReason        String?
  expelledAt            DateTime?
  expulsionReason       String?
  withdrawnAt           DateTime?
  withdrawalReason      String?
  transferredAt         DateTime?
  transferSchoolName    String?
  graduatedAt           DateTime?
  lastPromotedAt        DateTime?
  promotionHeld         Boolean         @default(false)
  registrationApplication RegistrationApplication?
  promotionLogs         PromotionLog[]
  yearSnapshots         StudentYearSnapshot[]
  enrollments           Enrollment[]
  grades                Grade[]
  termGrades            TermGrade[]
  reportCards           ReportCard[]
  attendanceRecords     AttendanceRecord[]
  incidents             DisciplineIncident[]
  counselingNotes       CounselingNote[]
  appointments          Appointment[]
  interventions         Intervention[]
  invoices              Invoice[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  @@index([status, gradeLevel])
  @@index([lastName, firstName])
}

model PromotionLog {
  id           String         @id @default(cuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromGrade    Int
  toGrade      Int
  academicYear String
  reason       String?
  promotedById String?
  promotedBy   User?          @relation("PromotionActor", fields: [promotedById], references: [id])
  createdAt    DateTime       @default(now())
  @@index([studentId, academicYear])
}

model StudentYearSnapshot {
  id           String         @id @default(cuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear String
  age          Int
  gradeLevel   Int
  status       StudentStatus
  snapshotDate DateTime       @default(now())
  @@unique([studentId, academicYear])
  @@index([academicYear, gradeLevel])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("Actor", fields: [actorId], references: [id])
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

model Term {
  id        String   @id @default(cuid())
  name      String
  type      TermType
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  sections  Section[]
  termGrades TermGrade[]
  reportCards ReportCard[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([name, type])
}

model Subject {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teacherSubjects TeacherSubject[]
  subjectOfferings SubjectOffering[]
  assessments Assessment[]
}

model TeacherSubject {
  id        String   @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([teacherId, subjectId])
  @@index([teacherId])
  @@index([subjectId])
}

model SubjectOffering {
  id         String   @id @default(cuid())
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  gradeLevel Int
  stream     Stream?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  @@unique([subjectId, gradeLevel, stream])
  @@index([gradeLevel, stream])
}

model Section {
  id          String   @id @default(cuid())
  code        String   @unique
  gradeLevel  Int
  sectionLetter String
  termId      String
  term        Term     @relation(fields: [termId], references: [id])
  name        String?
  room        String?
  capacity    Int?
  isActive    Boolean  @default(true)
  stream      SectionStream?
  enrollments Enrollment[]
  assessments Assessment[]
  attendanceRecords AttendanceRecord[]
  termGrades  TermGrade[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([gradeLevel, termId])
}

model SectionStream {
  id            String   @id @default(cuid())
  sectionId     String   @unique
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  stream        Stream
  status        String   @default("PENDING")
  proposedById  String?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Enrollment {
  id         String           @id @default(cuid())
  studentId  String
  student    StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sectionId  String
  section    Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  droppedAt  DateTime?
  @@unique([studentId, sectionId])
  @@index([sectionId, status])
}

model GradingCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  weight      Float
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  assessments Assessment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Assessment {
  id             String          @id @default(cuid())
  key            String          @unique @default(cuid())
  sectionId      String
  section        Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject         @relation(fields: [subjectId], references: [id])
  categoryId     String
  category       GradingCategory @relation(fields: [categoryId], references: [id])
  name           String
  type           AssessmentType
  maxScore       Float
  weight         Float
  assessmentDate DateTime?
  createdById    String?
  grades         Grade[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  @@index([sectionId, categoryId])
  @@index([subjectId])
}

model Grade {
  id           String       @id @default(cuid())
  assessmentId String
  assessment   Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score        Float?
  comment      String?
  status       GradeStatus  @default(DRAFT)
  createdById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  @@unique([assessmentId, studentId])
  @@index([studentId])
}

model TermGrade {
  id              String       @id @default(cuid())
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sectionId       String
  section         Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  termId          String
  term            Term         @relation(fields: [termId], references: [id])
  calculatedScore Float?
  finalScore      Float?
  letterGrade     String?
  gradePoints     Float?
  teacherComment  String?
  status          GradeStatus  @default(DRAFT)
  submittedAt     DateTime?
  submittedById   String?
  submittedByName String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  @@unique([studentId, sectionId, termId])
  @@index([termId, status])
}

model ReportCard {
  id          String       @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId      String
  term        Term         @relation(fields: [termId], references: [id])
  status      GradeStatus  @default(DRAFT)
  overallGPA  Float?
  comment     String?
  generatedAt DateTime?
  generatedById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@unique([studentId, termId])
}

model AttendanceRecord {
  id          String           @id @default(cuid())
  studentId   String
  student     StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sectionId   String
  section     Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  date        DateTime
  status      AttendanceStatus
  note        String?
  recordedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  @@unique([studentId, sectionId, date])
  @@index([sectionId, date])
}

model DisciplineIncident {
  id           String             @id @default(cuid())
  key          String             @unique @default(cuid())
  studentId    String
  student      StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title        String
  description  String
  severity     IncidentSeverity
  occurredAt   DateTime
  reportedById String?
  reportedByName String?
  actions      DisciplineAction[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  @@index([studentId, occurredAt])
}

model DisciplineAction {
  id           String               @id @default(cuid())
  key          String               @unique @default(cuid())
  incidentId   String
  incident     DisciplineIncident   @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type         DisciplineActionType
  startDate    DateTime?
  endDate      DateTime?
  notes        String?
  decidedById  String?
  decidedByName String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model CounselingNote {
  id            String              @id @default(cuid())
  key           String              @unique @default(cuid())
  studentId     String
  student       StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category      CounselingCategory
  riskLevel     RiskLevel           @default(NONE)
  title         String
  note          String
  counselorId   String?
  counselorName String?
  followUpDate  DateTime?
  resolved      Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  @@index([studentId, createdAt])
}

model Appointment {
  id            String            @id @default(cuid())
  key           String            @unique @default(cuid())
  studentId     String
  student       StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title         String
  scheduledAt   DateTime
  location      String?
  status        AppointmentStatus @default(SCHEDULED)
  notes         String?
  counselorId   String?
  counselorName String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  @@index([studentId, scheduledAt])
}

model Intervention {
  id            String               @id @default(cuid())
  key           String               @unique @default(cuid())
  studentId     String
  student       StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title         String
  description   String
  status        InterventionStatus   @default(PLANNED)
  startDate     DateTime?
  endDate       DateTime?
  counselorId   String?
  counselorName String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  @@index([studentId, status])
}

model FeeType {
  id          String   @id @default(cuid())
  key         String   @unique @default(cuid())
  name        String   @unique
  amount      Float
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status        InvoiceStatus @default(ISSUED)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  subtotal      Float
  total         Float
  amountPaid    Float         @default(0)
  notes         String?
  createdById   String?
  createdByName String?
  items         InvoiceItem[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([studentId, status])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  total       Float
  createdAt   DateTime @default(now())
}

model Payment {
  id             String        @id @default(cuid())
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount         Float
  method         PaymentMethod
  status         PaymentStatus @default(COMPLETED)
  reference      String?
  receivedById   String?
  receivedByName String?
  paidAt         DateTime      @default(now())
  notes          String?
  createdAt      DateTime      @default(now())
  @@index([invoiceId, status])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}